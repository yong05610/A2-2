{
  "database": {
    "path": "data/news.db"
  },
  "news_sources": {
    "rss_urls": [
      "https://news.google.com/rss?hl=ko&gl=KR&ceid=KR:ko"
    ],
    "crawl_url": "https://news.ycombinator.com/news"
  },
  "fetch": {
    "timeout": 10,
    "delay": 1.0,
    "user_agent": "Mozilla/5.0 (compatible; NewsAICLI/1.0)"
  },
  "clean": {
    "duplicate_policy": "skip"
  },
  "paths": {
    "logs": "logs"
  }
}
